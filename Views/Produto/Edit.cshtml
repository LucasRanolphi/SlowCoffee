@model SlowCoffee.Models.Produto

<h1>Editar Produto</h1>

<form method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label class="form-label">
            Nome
        </label>

        <input asp-for="Nome"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Categoria
        </label>

        <input asp-for="Categoria"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Preço
        </label>

        <input asp-for="Preco"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Estoque
        </label>

        <input asp-for="Estoque"
               class="form-control" />

    </div>

    <button class="btn btn-dark">
        Salvar Alterações
    </button>

</form>