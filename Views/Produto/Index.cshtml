@model List<SlowCoffee.Models.Produto>

<h1>Produtos da Slow Coffee</h1>

<a class="btn btn-dark mb-3"
   asp-controller="Produto"
   asp-action="Create">

    Novo Produto

</a>

<table class="table table-striped">

    <thead>

        <tr>

            <th>ID</th>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Ações</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var produto in Model)
        {
            <tr>

                <td>@produto.Id</td>

                <td>@produto.Nome</td>

                <td>@produto.Categoria</td>

                <td>R$ @produto.Preco</td>

                <td>@produto.Estoque</td>

                <td>

                    <a class="btn btn-warning btn-sm"
                       asp-controller="Produto"
                       asp-action="Edit"
                       asp-route-id="@produto.Id">

                        Editar

                    </a>

                    <a class="btn btn-danger btn-sm"
                       asp-controller="Produto"
                       asp-action="Delete"
                       asp-route-id="@produto.Id">

                        Excluir

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>