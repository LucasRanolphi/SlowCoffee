@model SlowCoffee.Models.Pedido

<h1>Editar Pedido</h1>

<form method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label class="form-label">
            Cliente
        </label>

        <select asp-for="Cliente"
                class="form-control">

            @foreach (var cliente in ViewBag.Clientes)
            {
                <option value="@cliente.Nome">
                    @cliente.Nome
                </option>
            }

        </select>

    </div>

    <div class="mb-3">

        <label class="form-label">
            Produto
        </label>

        <select asp-for="Produto"
                class="form-control">

            @foreach (var produto in ViewBag.Produtos)
            {
                <option value="@produto.Nome">
                    @produto.Nome
                </option>
            }

        </select>

    </div>

    <div class="mb-3">

        <label class="form-label">
            Quantidade
        </label>

        <input asp-for="Quantidade"
               class="form-control" />

    </div>

    <button class="btn btn-dark">
        Salvar Alterações
    </button>

</form>