@model List<SlowCoffee.Models.Pedido>

<h1>Pedidos da Slow Coffee</h1>

<a class="btn btn-dark mb-3"
   asp-controller="Pedido"
   asp-action="Create">

    Novo Pedido

</a>

<table class="table table-striped">

    <thead>

        <tr>

            <th>ID</th>
            <th>Cliente</th>
            <th>Produto</th>
            <th>Quantidade</th>
            <th>Total</th>
            <th>Ações</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var pedido in Model)
        {
            <tr>

                <td>@pedido.Id</td>

                <td>@pedido.Cliente</td>

                <td>@pedido.Produto</td>

                <td>@pedido.Quantidade</td>

                <td>R$ @pedido.ValorTotal</td>
                <td>

    <a class="btn btn-warning btn-sm"
       asp-controller="Pedido"
       asp-action="Edit"
       asp-route-id="@pedido.Id">

        Editar
        <a class="btn btn-danger btn-sm"
   asp-controller="Pedido"
   asp-action="Delete"
   asp-route-id="@pedido.Id">

    Excluir

</a>

    </a>

</td>

            </tr>
        }

    </tbody>

</table>