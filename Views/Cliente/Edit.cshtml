@model SlowCoffee.Models.Cliente

<h1>Editar Cliente</h1>

<form method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label class="form-label">
            Nome
        </label>

        <input asp-for="Nome"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Telefone
        </label>

        <input asp-for="Telefone"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Email
        </label>

        <input asp-for="Email"
               class="form-control" />

    </div>

    <button class="btn btn-dark">
        Salvar Alterações
    </button>

</form>