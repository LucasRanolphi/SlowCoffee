@model SlowCoffee.Models.Cliente

<h1>Novo Cliente</h1>

<form method="post">

    <div class="mb-3">

        <label class="form-label">
            Nome
        </label>

        <input asp-for="Nome"
               class="form-control" />

        <span asp-validation-for="Nome"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label class="form-label">
            Telefone
        </label>

        <input asp-for="Telefone"
               class="form-control" />

        <span asp-validation-for="Telefone"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label class="form-label">
            Email
        </label>

        <input asp-for="Email"
               class="form-control" />

        <span asp-validation-for="Email"
              class="text-danger">
        </span>

    </div>

    <button class="btn btn-dark">
        Salvar
    </button>

</form>