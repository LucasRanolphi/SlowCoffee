<h1 class="mb-4">
    📊 Relatórios da Slow Coffee
</h1>

<div class="row">

    <div class="col-md-3 mb-4">

        <div class="card shadow text-center">

            <div class="card-body">

                <h3>
                    Produtos
                </h3>

                <h1>
                    @ViewBag.TotalProdutos
                </h1>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card shadow text-center">

            <div class="card-body">

                <h3>
                    Clientes
                </h3>

                <h1>
                    @ViewBag.TotalClientes
                </h1>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card shadow text-center">

            <div class="card-body">

                <h3>
                    Pedidos
                </h3>

                <h1>
                    @ViewBag.TotalPedidos
                </h1>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card shadow text-center">

            <div class="card-body">

                <h3>
                    Faturamento
                </h3>

                <h1>
                    R$ @ViewBag.Faturamento
                </h1>

            </div>

        </div>

    </div>

</div>